{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "outDir": "dist",
        "rootDir": ".",
        "paths": {
            "@taskforge/shared": ["./packages/shared/src/index.ts"]
        }
    },
    "include": [
        "packages/api/src/**/*.ts",
        "packages/worker/src/**/*.ts",
        "packages/shared/src/**/*.ts"
    ],
    "exclude": [
        "node_modules",
        "dist",
        "packages/frontend"
    ]
}
