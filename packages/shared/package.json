{
    "name": "@taskforge/shared",
    "version": "1.0.0",
    "type": "module",
    "main": "src/index.ts",
    "types": "src/index.ts",
    "dependencies": {
        "amqplib": "^1.0.3",
        "node-pg-migrate": "^8.0.4",
        "pg": "^8.20.0"
    },
    "devDependencies": {
        "@types/amqplib": "^0.10.8",
        "@types/pg": "^8.20.0"
    },
    "scripts": {
        "migrate:create": "tsx ../../node_modules/node-pg-migrate/bin/node-pg-migrate --envPath ../../.env -m src/migrations -j ts create",
        "migrate:up": "tsx ../../node_modules/node-pg-migrate/bin/node-pg-migrate --envPath ../../.env -m src/migrations -j ts up",
        "migrate:test": "tsx ../../node_modules/node-pg-migrate/bin/node-pg-migrate --envPath ../../.env.test -m src/migrations -j ts up",
        "migrate:prod": "node-pg-migrate --envPath ../../.env -m ../../dist/packages/shared/src/migrations up"
    }
}
