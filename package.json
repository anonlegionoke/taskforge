{
    "name": "taskforge-monorepo",
    "version": "1.0.0",
    "private": "true",
    "workspaces": [
        "packages/*"
    ],
    "scripts": {
        "build": "npm run build --workspaces",
        "dev:api": "npm run dev --workspace=@taskforge/api",
        "dev:worker": "npm run dev --workspace=@taskforge/worker"
    },
    "devDependencies": {
        "@types/node": "25.6.0",
        "tsx": "^4.21.0",
        "typescript": "6.0.3"
    }
}
